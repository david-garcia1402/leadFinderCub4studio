HOST=127.0.0.1
PORT=4173
APP_ORIGIN=http://127.0.0.1:4173
OUTSCRAPER_API_KEY=
ENABLE_LIVE_SEARCH=false
ENABLE_SAMPLE_DATA=false
MAX_MONTHLY_RECORDS=100

# SEO: HTTPS origins without paths. Leave blank on local/staging deployments.
# PUBLIC_SITE_URL is this deployment; use the same language pair in both deployments.
PUBLIC_SITE_URL=
EN_SITE_URL=
PT_BR_SITE_URL=

# Contas e cobrança (somente esta versão pt-BR).
# DATA_DIR=./.data
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
# APP_ORIGIN must be the public HTTPS origin before Mercado Pago checkout can start.
