HOST=127.0.0.1
PORT=4173
APP_ORIGIN=http://127.0.0.1:4173
PUBLIC_SITE_URL=
EN_SITE_URL=
PT_BR_SITE_URL=
DATA_DIR=./.data
ENABLE_SAMPLE_DATA=false
# Configure your own Outscraper key on the server. It is never exposed to customers.
OUTSCRAPER_API_KEY=
# Default shared safety budget: 500 requested records for each 30-day window.
OUTSCRAPER_RECORD_CAP=500
OUTSCRAPER_BUDGET_DAYS=30
# Optional operator-controlled window start; leave blank to start with the first live search.
# To renew this shared budget, set a new ISO timestamp and restart after verifying provider usage.
OUTSCRAPER_BUDGET_START=
ENABLE_LIVE_SEARCH=false
# Run with Node.js 22.9 or later; no production dependencies.
# Versão pt-BR — todos os segredos ficam no ambiente do servidor, nunca no navegador.
# BILLING_PROVIDER=kiwify | hosted | mercadopago
BILLING_PROVIDER=kiwify
BILLING_PROVIDER_LABEL=Kiwify
# Kiwify: configure ofertas reais, IDs dos produtos e token do webhook antes de abrir os planos.
KIWIFY_WEBHOOK_TOKEN=
KIWIFY_CHECKOUT_ESSENCIAL=
KIWIFY_CHECKOUT_PROFISSIONAL=
KIWIFY_CHECKOUT_ESCALA=
KIWIFY_PRODUCT_ESSENCIAL=
KIWIFY_PRODUCT_PROFISSIONAL=
KIWIFY_PRODUCT_ESCALA=
# Checkout hospedado genérico: Hotmart, Eduzz, Stripe Payment Links etc.
# BILLING_PROVIDER=hosted
BILLING_WEBHOOK_SECRET=
CHECKOUT_URL_ESSENCIAL=
CHECKOUT_URL_PROFISSIONAL=
CHECKOUT_URL_ESCALA=
BILLING_PRODUCT_ESSENCIAL=
BILLING_PRODUCT_PROFISSIONAL=
BILLING_PRODUCT_ESCALA=
# Mercado Pago (opcional; APP_ORIGIN deve ser uma origem HTTPS pública).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
