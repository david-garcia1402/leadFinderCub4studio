HOST=127.0.0.1
PORT=4173
APP_ORIGIN=http://127.0.0.1:4173
PUBLIC_SITE_URL=
EN_SITE_URL=
PT_BR_SITE_URL=
DATA_DIR=./.data
ENABLE_SAMPLE_DATA=false
# Add the Outscraper key on the server after paid-customer demand is confirmed.
OUTSCRAPER_API_KEY=
# Per-server record cap; default 500 requested records per operator budget window.
OUTSCRAPER_RECORD_CAP=500
# Budget starts with the first search and is retained in .data/accounts.json for 30 days.
OUTSCRAPER_BUDGET_DAYS=30
# To start a fresh operator budget window, explicitly set a new ISO start time in the future.
OUTSCRAPER_BUDGET_START=
ENABLE_LIVE_SEARCH=false
# Run with Node.js 22.9 or later; no production dependencies.
# English build — keep this processor configuration in server environment variables only.
# Billing defaults to hosted checkout. No payment option is enabled until all required settings exist.
BILLING_PROVIDER=hosted
BILLING_PROVIDER_LABEL=Checkout
BILLING_WEBHOOK_SECRET=
CHECKOUT_URL_ESSENTIAL=
CHECKOUT_URL_PROFESSIONAL=
CHECKOUT_URL_SCALE=
# Product IDs let generic checkout webhooks associate each paid event with a plan.
BILLING_PRODUCT_ESSENTIAL=
BILLING_PRODUCT_PROFESSIONAL=
BILLING_PRODUCT_SCALE=
# Optional checkout integration. Set MP_ACCESS_TOKEN, MP_WEBHOOK_SECRET and BILLING_PROVIDER=mercadopago.
# Mercado Pago creates USD plan subscriptions only if its account/API supports this currency.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
